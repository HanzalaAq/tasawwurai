{
  "type": "math.derivative",
  "subject": "mathematics",
  "name": "Derivative Visualizer",
  "description": "Shows a function alongside its tangent line and derivative. Demonstrates the geometric meaning of differentiation.",
  "parameters": {
    "type": "object",
    "properties": {
      "expression": { "type": "string", "default": "x^3 - 3x", "description": "The function to differentiate" },
      "xMin": { "type": "number", "default": -4, "min": -100, "max": 0 },
      "xMax": { "type": "number", "default": 4, "min": 0.1, "max": 100 },
      "showTangent": { "type": "boolean", "default": true, "description": "Show the animated tangent line" }
    },
    "required": ["expression"]
  },
  "capabilities": { "interactive": true, "animated": true, "3d": false },
  "technology": "canvas-2d"
}
